{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NecropolisIdea",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "title", "summary", "pointers"],
  "properties": {
    "project_id": { "type": "string", "minLength": 5, "maxLength": 64 },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 5, "maxLength": 600 },
    "tags": {
      "type": "array",
      "maxItems": 15,
      "items": { "type": "string", "maxLength": 48 }
    },
    "pointers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["where", "fingerprint"],
        "properties": {
          "where": { "type": "string", "minLength": 1, "maxLength": 200 },
          "fingerprint": { "type": "string", "minLength": 16, "maxLength": 128 }
        }
      }
    }
  }
}
