{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NecropolisCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "one_liner",
    "status",
    "source_fingerprint",
    "generated_by"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "one_liner": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": ["unknown", "active", "finished", "abandoned", "archived", "recovered"]
    },
    "languages": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 32 }
    },
    "stack": {
      "type": "array",
      "maxItems": 25,
      "items": { "type": "string", "maxLength": 48 }
    },
    "entry_points": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 160 }
    },
    "ideas": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "where"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 120 },
          "where": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "reusable_modules": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 120 }
    },
    "gotchas": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 180 }
    },
    "commands": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 120 }
    },
    "why_stopped": {
      "type": "string",
      "maxLength": 200
    },
    "last_commit_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_fingerprint": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "generated_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    }
  }
}
